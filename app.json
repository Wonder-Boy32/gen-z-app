{
  "expo": {
    "name": "Gen Z",
    "slug": "gen-z-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "genz",
    "icon": "./assets/icon-launcher.png",
    "plugins": [
      "expo-image-picker",
      "expo-video",
      "expo-audio",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-launcher.png",
          "color": "#FF9D1F",
          "defaultChannel": "default"
        }
      ],
      "ffmpeg-expo",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Gen Z to save your anonymous cards to your photo library."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060A16",
          "image": "./assets/icon-launcher.png",
          "imageWidth": 180
        }
      ]
    ],
    "android": {
      "package": "com.genz.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-launcher.png",
        "backgroundColor": "#8A88C3"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "genz",
              "host": "anon"
            },
            {
              "scheme": "https",
              "host": "genz.app",
              "pathPrefix": "/anon"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.genz.app"
    },
    "extra": {
      "eas": {
        "projectId": "c61c8219-5801-4e40-81c0-4ca2f0ba13b0"
      }
    }
  }
}
