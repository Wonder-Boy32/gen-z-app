# Copy this file to .env and fill in your real values (never commit .env)
# Get these from Supabase: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Free Giphy API key (developers.giphy.com) - enables GIFs in chat.
# NOTE: anything prefixed EXPO_PUBLIC_ ships inside the app bundle, so treat
# this key as public. Use a key scoped to your app only.
EXPO_PUBLIC_GIPHY_API_KEY=your-giphy-api-key

# ---------------------------------------------------------------------------
# Nothing below belongs in the MOBILE project.
# The service-role key bypasses every RLS policy: it is server-side only.
# It is needed solely by admin/scripts/provision-admin.mjs, so it lives in
# admin/.env - never here, where `expo start` and EAS read the environment.
# ---------------------------------------------------------------------------
