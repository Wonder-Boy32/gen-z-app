# dependencies
node_modules/

# expo
.expo/
dist/
web-build/
expo-env.d.ts

# native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# env — .env.example IS committed on purpose (placeholders only, never real keys)
.env
.env.local
.env.*.local

# stray dev artifacts: Metro bundle dumps inline every EXPO_PUBLIC_* value, so
# they must never be committed
scripts/bundle-check.js
.verifiedfix.js

# scratch/repro dirs and generated config dumps (the repro dirs are ~280MB)
.repro*/
config_check.json
scripts/api-spec.json
*.tgz

# misc
.DS_Store
*.log

# expo tooling telemetry — dropped in the project root as a hash-named dir
expo-telemetry.json
npm-debug.*

# build cache (Node compile cache)
node-compile-cache/

# dated brand-asset backups - keep out of history
assets/_brand-backup*/
