{
  "name": "gen-z-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "postinstall": "node scripts/ensure-rn-android.js && node scripts/patch-ffmpeg-expo.js",
    "check:env": "node scripts/preflight-env.js",
    "check:types": "tsc --noEmit",
    "check": "node scripts/preflight-env.js && tsc --noEmit",
    "migrate:media": "node scripts/migrate-private-media.mjs",
    "build:preview": "node scripts/preflight-env.js && eas build --platform android --profile preview",
    "build:prod": "node scripts/preflight-env.js && eas build --platform android --profile production",
    "verify:sql": "python scripts/sql-verify/verify.py"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.109.0",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-blob": "^57.0.1",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.22",
    "expo-screen-capture": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-video": "~57.0.5",
    "ffmpeg-expo": "^0.1.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-view-shot": "5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "ffmpeg-static": "^5.3.0",
    "typescript": "~6.0.3"
  }
}
